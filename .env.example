# Copy this file to .env and set a long random value for real deployments.
SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=sqlite:///website_analyzer.db
MAX_PAGES=20
MAX_DEPTH=2
REQUEST_DELAY_SECONDS=0.25
SCAN_TIMEOUT_SECONDS=60
REQUEST_CONNECT_TIMEOUT_SECONDS=5
REQUEST_READ_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=2000000
MAX_ROBOTS_BYTES=262144
MAX_LINK_CHECKS=30
USER_AGENT=PortfolioWebsiteAnalyzer/1.0 (+local educational website analysis)
MAX_LINKS_PER_PAGE=500
MAX_LINK_RESULTS=2000
